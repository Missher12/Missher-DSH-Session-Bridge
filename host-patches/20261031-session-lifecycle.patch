+import { mkdtemp, readdir, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import { afterEach, describe, expect, it } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { SessionAlreadyOwnedError, SessionPersistenceChildExistsError } from '@deepseek-ai/dsh-session-persistence'
+import * as JsonlSessionPersistence from '../src/index.ts'
+import { sessionDir } from '../src/format.ts'
+import { meta, oneTurnLog } from '../../session-persistence/tests/contract.ts'
+
+const roots: string[] = []
+
+async function mount(): Promise<{
+  persistence: Context['sessionPersistence']
+  root: string
+  dispose: () => Promise<void>
+}> {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-jsonl-delete-'))
+  roots.push(root)
+  const ctx = new Context()
+  const fiber = await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  return {
+    persistence: ctx.sessionPersistence,
+    root,
+    dispose: async () => {
+      await fiber.dispose()
+      await rm(root, { recursive: true, force: true })
+    },
+  }
+}
+
+async function store(persistence: Context['sessionPersistence'], id: string, parentSession?: string): Promise<void> {
+  const header = {
+    ...meta(id, '/tmp/project'),
+    ...(parentSession === undefined ? {} : { parentSession: SessionId(parentSession) }),
+  }
+  const handle = await persistence.create(header)
+  await handle.append(oneTurnLog())
+  await handle.close()
+}
+
+afterEach(async () => {
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true })
+})
+
+describe('JsonlSessionPersistence deletion transaction', () => {
+  it('removes a stored session, keeps a tombstone, and lets the same identity be created again', async () => {
+    const { persistence, root, dispose } = await mount()
+    try {
+      await store(persistence, 'deletable')
+      expect(await persistence.stat(SessionId('deletable'))).toBeDefined()
+      await persistence.delete(SessionId('deletable'))
+      expect(await persistence.stat(SessionId('deletable'))).toBeUndefined()
+      expect(await persistence.list()).toEqual([])
+      const dir = sessionDir(root, '/tmp/project', SessionId('deletable'))
+      const entries = await readdir(dir)
+      expect(entries).toContain('session.deleted')
+      expect(entries.some(name => name.startsWith('session.v') || name === 'session.jsonl')).toBe(false)
+      // A reused identity must clear the marker instead of inheriting a hidden Session.
+      await store(persistence, 'deletable')
+      expect(await persistence.stat(SessionId('deletable'))).toBeDefined()
+      expect(await readdir(dir)).not.toContain('session.deleted')
+    } finally {
+      await dispose()
+    }
+  })
+
+  it('refuses while a derived child session exists and deletes parent after the child', async () => {
+    const { persistence, dispose } = await mount()
+    try {
+      await store(persistence, 'parent')
+      await store(persistence, 'child', 'parent')
+      await expect(persistence.delete(SessionId('parent'))).rejects.toBeInstanceOf(SessionPersistenceChildExistsError)
+      expect(await persistence.stat(SessionId('parent'))).toBeDefined()
+      await persistence.delete(SessionId('child'))
+      await persistence.delete(SessionId('parent'))
+      expect(await persistence.list()).toEqual([])
+    } finally {
+      await dispose()
+    }
+  })
+
+  it('refuses while another writer owns the session', async () => {
+    const { persistence, dispose } = await mount()
+    try {
+      await store(persistence, 'busy')
+      const reader = await persistence.open(SessionId('busy'), 'read')
+      const writer = await persistence.open(SessionId('busy'), 'write')
+      try {
+        await expect(persistence.delete(SessionId('busy'))).rejects.toBeInstanceOf(SessionAlreadyOwnedError)
+      } finally {
+        await writer.close()
+        await reader.close()
+      }
+      await persistence.delete(SessionId('busy'))
+      expect(await persistence.stat(SessionId('busy'))).toBeUndefined()
+    } finally {
+      await dispose()
+    }
+  })
+})
