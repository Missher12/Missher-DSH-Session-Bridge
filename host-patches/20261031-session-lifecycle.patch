+import { mkdir, mkdtemp, readFile, realpath, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import { afterEach, describe, expect, it } from 'vitest'
+import { mountAgentLoopTestDependencies, mountAgentLoopTestHarness } from '@deepseek-ai/dsh-agent-loop-testkit'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import SessionQueryEngine from '@deepseek-ai/dsh-session-query'
+import Storage from '@deepseek-ai/dsh-storage'
+import { DomainFacility } from '@deepseek-ai/dsh-storage-domain'
+import TypertRegistry from '@deepseek-ai/dsh-typert-registry'
+import WorkspaceRegistry from '@deepseek-ai/dsh-workspace'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { MemoryMediaPool, MemoryStorageBackend } from '../../../storage/storage-domain/tests/helpers/memory-backend.ts'
+import type {} from '@deepseek-ai/dsh-working-directory'
+import { ApiSessionAgentController } from '../src/agent.ts'
+import { installModelSelectionProjection } from '../src/model-selection-projection.ts'
+import { SessionLifecycleController } from '../src/lifecycle.ts'
+
+const contexts: Context[] = []
+const roots: string[] = []
+
+afterEach(async () => {
+  await Promise.all(contexts.splice(0).map(ctx => ctx.fiber.dispose()))
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true })
+})
+
+interface Stack {
+  readonly ctx: Context
+  readonly root: string
+  readonly dirA: string
+  readonly dirB: string
+  readonly pool: MemoryMediaPool
+  readonly registry: Context['workspaceRegistry']
+  readonly persistence: Context['sessionPersistence']
+  readonly agents: ApiSessionAgentController
+  readonly lifecycle: SessionLifecycleController
+}
+
+/** Mount the real agent loop, real JSONL session store, and a durable workspace domain. */
+async function boot(root: string, pool: MemoryMediaPool): Promise<Stack> {
+  const dirA = join(root, 'project-a')
+  const dirB = join(root, 'project-b')
+  await mkdir(dirA, { recursive: true })
+  await mkdir(dirB, { recursive: true })
+  await mkdir(root, { recursive: true })
+  await writeFile(join(dirA, 'keep.txt'), 'keep')
+  await writeFile(join(dirB, 'keep.txt'), 'keep')
+  const ctx = new Context()
+  contexts.push(ctx)
+  await mountAgentLoopTestDependencies(ctx, { workingDirectory: true })
+  installModelSelectionProjection(ctx)
+  await ctx.plugin(TypertRegistry)
+  await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  await ctx.plugin(SessionQueryEngine)
+  await ctx.plugin(Storage)
+  ctx.storage.backend.register('memory', new MemoryStorageBackend(pool))
+  const facility = new DomainFacility(ctx, { backend: 'memory', routes: {} })
+  ctx.storage.mount('domain', facility)
+  ctx.provide('storageDomain', facility)
+  await ctx.plugin(WorkspaceRegistry)
+  ctx.provide('agentDefaultModel', {
+    currentSelection: () => ({ provider: 'fixture', model: 'fixture-model' }),
+    saveSelection: () => Promise.resolve(),
+  } as never)
+  await mountAgentLoopTestHarness(ctx)
+  const agents = new ApiSessionAgentController(ctx)
+  return {
+    ctx,
+    root,
+    dirA: await realpath(dirA),
+    dirB: await realpath(dirB),
+    pool,
+    registry: ctx.workspaceRegistry,
+    persistence: ctx.sessionPersistence,
+    agents,
+    lifecycle: new SessionLifecycleController(ctx, agents),
+  }
+}
+
+async function fixture(): Promise<Stack> {
+  const parent = await mkdtemp(join(tmpdir(), 'dsh-lifecycle-real-'))
+  roots.push(parent)
+  return await boot(join(parent, 'sessions'), new MemoryMediaPool())
+}
+
+/** Create one live, idle Agent through the controller and attach it to a real workspace. */
+async function idleSession(stack: Stack): Promise<{
+  id: SessionId
+  workspaceId: string
+  baseline: readonly SessionEvent[]
+}> {
+  const workspace = await stack.registry.create(stack.dirA)
+  const created = await stack.agents.createSession({ cwd: stack.dirA, reusable: () => true })
+  const agent = created.agent
+  agent.session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text: 'original question before the move' }],
+    source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+  agent.session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text: 'follow-up question before the move' }],
+    source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+  agent.session.append('session/title', {
+    title: 'Original moved title',
+    messageSeqs: [],
+    source: { kind: 'user' },
+  })
+  await stack.ctx.sessions.flush(agent.session)
+  await stack.persistence.flush()
+  await workspace.attachSession(agent.id)
+  expect(stack.ctx.agents.get(agent.id)?.status).toBe('idle')
+  const read = await stack.persistence.open(agent.id, 'read')
+  const baseline = (await read.read(0)).events
+  await read.close()
+  return { id: agent.id, workspaceId: String(workspace.id), baseline }
+}
+
+async function membership(stack: Stack, workspaceId: string): Promise<readonly string[]> {
+  return stack.registry.get(workspaceId as never)?.sessionIds.map(id => String(id)) ?? []
+}
+
+async function restart(stack: Stack): Promise<Stack> {
+  await stack.ctx.fiber.dispose()
+  const index = contexts.indexOf(stack.ctx)
+  if (index >= 0) contexts.splice(index, 1)
+  return await boot(stack.root, stack.pool)
+}
+
+describe('SessionLifecycleController with real storage and idle agents', () => {
+  it('releases a used-but-idle agent and permanently deletes its real log', async () => {
+    const stack = await fixture()
+    const { id, workspaceId } = await idleSession(stack)
+    expect(await stack.persistence.stat(id)).toBeDefined()
+    await stack.lifecycle.deleteSession(id)
+    expect(stack.ctx.agents.get(id)).toBeUndefined()
+    expect(await stack.persistence.stat(id)).toBeUndefined()
+    expect((await stack.persistence.list()).map(entry => String(entry.header.id))).not.toContain(String(id))
+    expect(await membership(stack, workspaceId)).not.toContain(String(id))
+    expect(await readFile(join(stack.dirA, 'keep.txt'), 'utf8')).toBe('keep')
+    const restarted = await restart(stack)
+    expect((await restarted.persistence.list()).map(entry => String(entry.header.id))).not.toContain(String(id))
+    expect(await membership(restarted, workspaceId)).not.toContain(String(id))
+  })
+
+  it('deletes an unmaterialized blank session after legally releasing it', async () => {
+    const stack = await fixture()
+    const workspace = await stack.registry.create(stack.dirA)
+    const created = await stack.agents.createSession({ cwd: stack.dirA, reusable: () => true })
+    await workspace.attachSession(created.agent.id)
+    expect(stack.ctx.agents.get(created.agent.id)?.status).toBe('idle')
+    expect((await stack.persistence.stat(created.agent.id))?.location).toBeUndefined()
+    await expect(stack.lifecycle.deleteSession(created.agent.id)).resolves.toBeUndefined()
+    expect(stack.ctx.agents.get(created.agent.id)).toBeUndefined()
+    expect(await stack.persistence.stat(created.agent.id)).toBeUndefined()
+    expect(await membership(stack, String(workspace.id))).not.toContain(String(created.agent.id))
+  })
+
+  it('moves a used-but-idle agent to another workspace with real log and effective directory', async () => {
+    const stack = await fixture()
+    const { id, workspaceId: sourceId, baseline } = await idleSession(stack)
+    const target = await stack.registry.create(stack.dirB)
+    await stack.lifecycle.moveSession(id, String(target.id))
+    expect(await membership(stack, sourceId)).not.toContain(String(id))
+    expect(await membership(stack, String(target.id))).toContain(String(id))
+    expect(await readFile(join(stack.dirA, 'keep.txt'), 'utf8')).toBe('keep')
+    expect(await readFile(join(stack.dirB, 'keep.txt'), 'utf8')).toBe('keep')
+    const read = await stack.persistence.open(id, 'read')
+    const events = (await read.read(0)).events
+    await read.close()
+    expect(events.length).toBe(baseline.length + 1)
+    expect(events.slice(0, baseline.length)).toEqual(baseline)
+    expect(events.filter((event: SessionEvent) => event.type === 'user/message')).toHaveLength(2)
+    expect(events.findLast((event: SessionEvent) => event.type === 'session/title')?.data)
+      .toMatchObject({ title: 'Original moved title' })
+    expect(events.filter((event: SessionEvent) => event.type === 'working-directory/change').at(-1)?.data)
+      .toEqual({ cwd: stack.dirB })
+    // Resume through the controller's own path: the effective directory is the target.
+    const resumed = await stack.agents.resolveAgent(id)
+    expect('agent' in resumed).toBe(true)
+    if ('agent' in resumed) {
+      expect(stack.ctx.workingDirectory.get(resumed.agent.session)).toBe(stack.dirB)
+    }
+    const restarted = await restart(stack)
+    const restartedTarget = restarted.registry.list().find(workspace => workspace.path === stack.dirB)
+    expect(restartedTarget?.sessionIds.map(value => String(value))).toContain(String(id))
+    const replay = await restarted.persistence.open(id, 'read')
+    const replayed = (await replay.read(0)).events
+    await replay.close()
+    expect(String(replay.header.id)).toBe(String(id))
+    expect(replayed.slice(0, baseline.length)).toEqual(baseline)
+    expect(replayed.findLast((event: SessionEvent) => event.type === 'session/title')?.data)
+      .toMatchObject({ title: 'Original moved title' })
+    expect(replayed.filter((event: SessionEvent) => event.type === 'working-directory/change').at(-1)?.data)
+      .toEqual({ cwd: stack.dirB })
+  })
+
+  it('moves two different real sessions through the shared queue', async () => {
+    const stack = await fixture()
+    const first = await idleSession(stack)
+    const second = await idleSession(stack)
+    const target = await stack.registry.create(stack.dirB)
+    await Promise.all([
+      stack.lifecycle.moveSession(first.id, String(target.id)),
+      stack.lifecycle.moveSession(second.id, String(target.id)),
+    ])
+    expect(await membership(stack, first.workspaceId)).not.toContain(String(first.id))
+    expect(await membership(stack, second.workspaceId)).not.toContain(String(second.id))
+    expect(await membership(stack, String(target.id))).toEqual(expect.arrayContaining([String(first.id), String(second.id)]))
+    for (const entry of [first, second]) {
+      const read = await stack.persistence.open(entry.id, 'read')
+      const events = (await read.read(0)).events
+      await read.close()
+      expect(events.filter((event: SessionEvent) => event.type === 'working-directory/change').at(-1)?.data)
+        .toEqual({ cwd: stack.dirB })
+      expect(events.slice(0, entry.baseline.length)).toEqual(entry.baseline)
+    }
+  })
+
+  it('refuses an externally owned session and a running agent', async () => {
+    const stack = await fixture()
+    const foreignHeader = {
+      version: 4,
+      id: SessionId('session-foreign-owner'),
+      createdAt: 1,
+      isSeeded: false,
+      cwd: stack.dirA,
+    }
+    const foreign = await stack.persistence.create(foreignHeader, { inheritedEventCount: 0 as never })
+    await foreign.append([{ type: 'working-directory/change', seq: 0 as never, time: 1, data: { cwd: stack.dirA } } as never])
+    await foreign.close()
+    const writer = await stack.persistence.open(SessionId('session-foreign-owner'), 'write')
+    try {
+      await expect(stack.lifecycle.deleteSession(SessionId('session-foreign-owner')))
+        .rejects.toMatchObject({ code: 'session/delete-owned' })
+    } finally {
+      await writer.close()
+    }
+    const second = await idleSession(stack)
+    const agent = stack.ctx.agents.get(second.id)
+    if (agent === undefined) throw new Error('expected a live agent')
+    Object.defineProperty(agent, 'status', { configurable: true, value: 'running' })
+    const target = await stack.registry.create(stack.dirB)
+    await expect(stack.lifecycle.moveSession(second.id, String(target.id)))
+      .rejects.toMatchObject({ code: 'session/move-active' })
+  })
+})
