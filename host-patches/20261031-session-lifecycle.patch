+import { mkdir, mkdtemp, realpath, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import { afterEach, describe, expect, it } from 'vitest'
+import Storage from '@deepseek-ai/dsh-storage'
+import { DomainFacility } from '@deepseek-ai/dsh-storage-domain'
+import { SESSION_FORMAT_VERSION, SessionId, SessionSeq } from '@deepseek-ai/dsh-session'
+import type { SessionEvent, SessionHeader } from '@deepseek-ai/dsh-session'
+import { SessionPersistenceRevision } from '@deepseek-ai/dsh-session-persistence'
+import { MemoryMediaPool, MemoryStorageBackend } from '../../../storage/storage-domain/tests/helpers/memory-backend.ts'
+import WorkspaceRegistry from '../src/index.ts'
+
+const roots: string[] = []
+
+interface Volume {
+  readonly headers: Map<string, SessionHeader>
+  readonly events: Map<string, SessionEvent[]>
+  failNextAppend: boolean
+}
+
+/**
+ * Header/event persistence double for the move journal. The operations here
+ * are the same service surface the real seam exposes; only durable bytes are
+ * replaced, so recovery logic and event shapes are exercised unmodified.
+ */
+function volume(): Volume {
+  return { headers: new Map(), events: new Map(), failNextAppend: false }
+}
+
+function header(id: string, cwd: string): SessionHeader {
+  return { version: SESSION_FORMAT_VERSION, id: SessionId(id), createdAt: 1, isSeeded: false, cwd }
+}
+
+function persistenceFor(state: Volume) {
+  return {
+    async list() {
+      return [...state.headers.values()].map(header => ({ header, revision: SessionPersistenceRevision('rev') }))
+    },
+    async stat(id: string) {
+      const found = state.headers.get(id)
+      return found === undefined ? undefined : { header: found, revision: SessionPersistenceRevision('rev') }
+    },
+    async open(id: string) {
+      const found = state.headers.get(id)
+      if (found === undefined) throw new Error(`missing ${id}`)
+      const events = state.events.get(id) ?? []
+      return {
+        header: found,
+        read: async () => ({ events }),
+        append: async (batch: readonly SessionEvent[]) => {
+          if (state.failNextAppend) {
+            state.failNextAppend = false
+            throw new Error('injected append failure')
+          }
+          events.push(...batch)
+          state.events.set(id, events)
+        },
+        close: async () => {},
+      }
+    },
+  }
+}
+
+async function workspaceDirs(): Promise<{ a: string; b: string }> {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-workspace-move-'))
+  roots.push(root)
+  const a = join(root, 'project-a')
+  const b = join(root, 'project-b')
+  await mkdir(a)
+  await mkdir(b)
+  return { a: await realpath(a), b: await realpath(b) }
+}
+
+async function boot(pool: MemoryMediaPool, state: Volume) {
+  const ctx = new Context()
+  await ctx.plugin(Storage)
+  ctx.storage.backend.register('memory', new MemoryStorageBackend(pool))
+  const facility = new DomainFacility(ctx, { backend: 'memory', routes: {} })
+  ctx.storage.mount('domain', facility)
+  ctx.provide('storageDomain', facility)
+  ctx.provide('sessionPersistence', persistenceFor(state) as never)
+  ctx.provide('sessions', { get: () => undefined, list: () => [] } as never)
+  const fiber = await ctx.plugin(WorkspaceRegistry)
+  return { ctx, fiber, registry: ctx.workspaceRegistry }
+}
+
+afterEach(async () => {
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true })
+})
+
+describe('WorkspaceRegistry move journal', () => {
+  it('recovers an effective directory and membership together after a restart', async () => {
+    const { a, b } = await workspaceDirs()
+    const state = volume()
+    state.headers.set('session-move', header('session-move', a))
+    state.events.set('session-move', [])
+    const pool = new MemoryMediaPool()
+    const first = await boot(pool, state)
+    const source = first.registry.list().find(workspace => workspace.path === a)
+    expect(source).toBeDefined()
+    const target = await first.registry.create(b)
+    await first.registry.beginSessionMove(SessionId('session-move'), target.id)
+    await first.fiber.dispose()
+
+    // Simulated restart: the marker is durable, neither cwd nor membership has
+    // been applied yet. Recovery must complete both halves.
+    const second = await boot(pool, state)
+    const reloaded = second.registry.list()
+    const reloadedSource = reloaded.find(workspace => workspace.path === a)
+    const reloadedTarget = reloaded.find(workspace => workspace.path === b)
+    expect(reloadedSource?.sessionIds).not.toContain(SessionId('session-move'))
+    expect(reloadedTarget?.sessionIds).toContain(SessionId('session-move'))
+    const changes = state.events.get('session-move') ?? []
+    expect(changes.filter(event => event.type === 'working-directory/change').map(event => event.data)).toEqual([{ cwd: b }])
+    await second.fiber.dispose()
+  })
+
+  it('is idempotent when the directory event committed before the crash', async () => {
+    const { a, b } = await workspaceDirs()
+    const state = volume()
+    state.headers.set('session-move', header('session-move', a))
+    state.events.set('session-move', [])
+    const pool = new MemoryMediaPool()
+    const first = await boot(pool, state)
+    const target = await first.registry.create(b)
+    await first.registry.beginSessionMove(SessionId('session-move'), target.id)
+    const handle = await (persistenceFor(state).open('session-move') as Promise<{
+      append: (batch: readonly SessionEvent[]) => Promise<void>
+      close: () => Promise<void>
+    }>)
+    await handle.append([{
+      type: 'working-directory/change',
+      seq: SessionSeq(0),
+      time: 2,
+      data: { cwd: b },
+    } as SessionEvent])
+    await handle.close()
+    await first.fiber.dispose()
+
+    const second = await boot(pool, state)
+    const changes = (state.events.get('session-move') ?? []).filter(event => event.type === 'working-directory/change')
+    expect(changes).toHaveLength(1)
+    const reloadedTarget = second.registry.list().find(workspace => workspace.path === b)
+    expect(reloadedTarget?.sessionIds).toContain(SessionId('session-move'))
+    await second.fiber.dispose()
+  })
+
+
+  it('recovers a failed marker before a new move and never overwrites it', async () => {
+    const { a, b } = await workspaceDirs()
+    const state = volume()
+    state.headers.set('session-one', header('session-one', a))
+    state.headers.set('session-two', header('session-two', a))
+    state.events.set('session-one', [])
+    state.events.set('session-two', [])
+    const pool = new MemoryMediaPool()
+    const first = await boot(pool, state)
+    const source = first.registry.list().find(workspace => workspace.path === a)
+    const target = await first.registry.create(b)
+    await first.registry.beginSessionMove(SessionId('session-one'), target.id)
+    state.failNextAppend = true
+    await expect(first.registry.completeSessionMove(SessionId('session-one'))).rejects.toThrow(/injected append failure/)
+    // Queueing the second move must first finish the failed first marker instead
+    // of overwriting it with session-two's intent.
+    await first.registry.moveSession(SessionId('session-two'), target.id)
+    const reloaded = first.registry.list()
+    const movedSource = reloaded.find(workspace => workspace.path === a)
+    const movedTarget = reloaded.find(workspace => workspace.path === b)
+    expect(movedSource?.sessionIds).not.toContain(SessionId('session-one'))
+    expect(movedSource?.sessionIds).not.toContain(SessionId('session-two'))
+    expect(movedTarget?.sessionIds).toEqual(expect.arrayContaining([SessionId('session-one'), SessionId('session-two')]))
+    for (const id of ['session-one', 'session-two']) {
+      expect((state.events.get(id) ?? []).filter(event => event.type === 'working-directory/change'))
+        .toEqual([expect.objectContaining({ data: { cwd: b } })])
+    }
+    await first.fiber.dispose()
+    const second = await boot(pool, state)
+    const reloadedTarget = second.registry.list().find(workspace => workspace.path === b)
+    expect(reloadedTarget?.sessionIds).toEqual(expect.arrayContaining([SessionId('session-one'), SessionId('session-two')]))
+    await second.fiber.dispose()
+  })
+
+  it('leaves the marker to recovery when completion fails mid-way', async () => {
+    const { a, b } = await workspaceDirs()
+    const state = volume()
+    state.headers.set('session-move', header('session-move', a))
+    state.events.set('session-move', [])
+    const pool = new MemoryMediaPool()
+    const first = await boot(pool, state)
+    const source = first.registry.list().find(workspace => workspace.path === a)
+    const target = await first.registry.create(b)
+    await first.registry.beginSessionMove(SessionId('session-move'), target.id)
+    state.failNextAppend = true
+    await expect(first.registry.completeSessionMove(SessionId('session-move'))).rejects.toThrow(/injected append failure/)
+    // The failed completion did not move membership either.
+    expect(source?.sessionIds).toContain(SessionId('session-move'))
+    await first.fiber.dispose()
+
+    const second = await boot(pool, state)
+    const reloadedSource = second.registry.list().find(workspace => workspace.path === a)
+    const reloadedTarget = second.registry.list().find(workspace => workspace.path === b)
+    expect(reloadedSource?.sessionIds).not.toContain(SessionId('session-move'))
+    expect(reloadedTarget?.sessionIds).toContain(SessionId('session-move'))
+    expect((state.events.get('session-move') ?? []).filter(event => event.type === 'working-directory/change')).toHaveLength(1)
+    await second.fiber.dispose()
+  })
+})
